<?xml version="1.0" encoding="utf-8"?>
<!-- Flush YouTube-Music-style song row: no card, no boxed panel background, no accent bar; just artwork + text flush on the screen background with a ripple on tap, matching every other list row redesigned this pass. Root is now the ConstraintLayout directly (previously wrapped in a MaterialCardView); all other view ids kept identical for binding compatibility. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="64dp"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/song_artwork"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/album_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedImageView" />

    <LinearLayout
        android:id="@+id/song_info_stack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/song_artwork"
        app:layout_constraintEnd_toStartOf="@id/song_duration"
        app:layout_constraintStart_toEndOf="@id/song_artwork"
        app:layout_constraintTop_toTopOf="@id/song_artwork">

        <TextView
            android:id="@+id/song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Song Title"
            android:textAppearance="@style/TextAppearance.StashWave.Body"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artist • Album"
            android:textAppearance="@style/TextAppearance.StashWave.Subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/song_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3:45"
        android:textAppearance="@style/TextAppearance.StashWave.Subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/song_artwork"
        app:layout_constraintEnd_toStartOf="@id/menu_button"
        app:layout_constraintTop_toTopOf="@id/song_artwork" />

    <ImageButton
        android:id="@+id/menu_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="More options"
        android:padding="2dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="@id/song_artwork"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/song_artwork" />

</androidx.constraintlayout.widget.ConstraintLayout>
