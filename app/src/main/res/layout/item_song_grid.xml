<?xml version="1.0" encoding="utf-8"?>
<!-- The old MaterialCardView wrapper here was already fully transparent/borderless/zero-elevation: it did nothing visually, so it's removed outright rather than restyled, eliminating the runtime .radius/.cardElevation risk (see SongAdapter.kt's GridViewHolder). Root is now this LinearLayout directly; its own song_grid_panel_background is a flat gradient+thin-stroke tile shape (not the old neomorphic "pillow" style), kept as-is since a subtle tile shape reads fine for a grid, unlike a flush list row. All view ids kept identical for binding compatibility. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/song_grid_panel_background"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/song_artwork"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/album_artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/RoundedImageView" />

        <View
            android:id="@+id/song_grid_scrim"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/song_grid_scrim"
            app:layout_constraintBottom_toBottomOf="@id/song_artwork"
            app:layout_constraintEnd_toEndOf="@id/song_artwork"
            app:layout_constraintStart_toStartOf="@id/song_artwork" />

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:padding="2dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Song Title"
            android:textAppearance="@style/TextAppearance.StashWave.Body"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artist"
            android:textAppearance="@style/TextAppearance.StashWave.Subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
