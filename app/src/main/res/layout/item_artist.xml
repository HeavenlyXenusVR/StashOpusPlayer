<?xml version="1.0" encoding="utf-8"?>
<!-- Flush YouTube-Music-style row with a circular avatar (YT Music shows artist rows as circular photos, unlike the square/rounded thumbnails everywhere else). No card border/elevation; all view ids kept identical to the old MaterialCardView version for binding compatibility. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/artist_artwork"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_person"
        app:shapeAppearanceOverlay="@style/CircularImageView" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artist Name"
            android:textAppearance="@style/TextAppearance.StashWave.Body"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/song_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="12 songs"
            android:textAppearance="@style/TextAppearance.StashWave.Subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/arrow_forward"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:alpha="0.6"
        android:contentDescription="View artist"
        android:src="@drawable/ic_arrow_forward"
        android:tint="@color/text_secondary" />

</LinearLayout>
