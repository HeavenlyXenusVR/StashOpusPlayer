<?xml version="1.0" encoding="utf-8"?>
<!-- Flat replacement for the old dual-shadow "pillow" mini player background. Used by the legacy "Classic" MiniPlayerView (RevampedMiniPlayerView, the default live style, was already flattened directly in its own layout; see view_revamped_mini_player.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_color" />
    <corners android:radius="18dp" />
</shape>
