<?xml version="1.0" encoding="utf-8"?>
<!-- Flat replacement for the old dual-shadow gradient accent button. A plain flat filled circle (no gradient, no raised shadow): this one stays visibly filled at rest since it's meant to read as the prominent/primary action (e.g. play buttons), just flat instead of pillow-shaped. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_gradient_end" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent_gradient_start" />
        </shape>
    </item>
</selector>
