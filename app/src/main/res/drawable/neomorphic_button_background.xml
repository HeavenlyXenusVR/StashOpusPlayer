<?xml version="1.0" encoding="utf-8"?>
<!-- Flat replacement for the old dual-shadow "pillow" button background. Transparent at rest, a plain flat circular fill on press: a borderless icon button with minimal press feedback, matching the plain-icon-button language used on the restyled Mini Player/Now Playing screens, instead of a permanently-raised shadowed circle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
