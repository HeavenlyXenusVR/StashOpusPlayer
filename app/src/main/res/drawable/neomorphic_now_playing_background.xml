<?xml version="1.0" encoding="utf-8"?>
<!-- Flat replacement for the old dual-shadow "pillow" now-playing panel background. NowPlayingActivity's own cards are flattened directly at runtime (applyArtworkAwareStyling), so this drawable is mostly a fallback/unused-elsewhere safety net now, kept flat for consistency if referenced. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_color" />
    <corners android:radius="28dp" />
</shape>
