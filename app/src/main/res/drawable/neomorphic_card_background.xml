<?xml version="1.0" encoding="utf-8"?>
<!-- Flat replacement for the old dual-shadow "pillow" card background (see git history for the previous layer-list version). Single flat fill + a thin translucent stroke, matching the flat panel language used elsewhere in this pass (Home shelves, Now Playing). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_background" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" />
</shape>
