# Track APK files with Git LFS
*.apk filter=lfs diff=lfs merge=lfs -text
*.aab filter=lfs diff=lfs merge=lfs -text
# Track keystore files
*.keystore filter=lfs diff=lfs merge=lfs -text
*.jks filter=lfs diff=lfs merge=lfs -text
# Track large asset files
*.so filter=lfs diff=lfs merge=lfs -text
# Track media files that might be used as test data
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
*.opus filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# NOTE: *.jar/*.png/*.jpg/*.jpeg/*.webp were previously routed through Git LFS,
# but every object of those types in this repo's LFS store 404s on GitHub (LFS
# storage was apparently never actually populated) -- including the app's own
# launcher icons and the Gradle wrapper jar, which silently broke every build.
# These extensions aren't genuinely "large" (icons: KBs, wrapper jar: ~43KB),
# so they're committed as normal git blobs going forward instead. Files still
# under docs/ (screenshots) and the release keystore remain broken LFS
# pointers from before this fix and need real content re-supplied separately.
# Track build outputs and large files
app/build/outputs/**/*.apk filter=lfs diff=lfs merge=lfs -text
app/build/outputs/**/*.aab filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
bin/* filter=lfs diff=lfs merge=lfs -text
